# Copie para .config/.env (ou .env na raiz) e preencha apenas com dados locais.
ENVIRONMENT=development
ACOMPANHAMENTO_HOST=127.0.0.1
ACOMPANHAMENTO_PORT=8000
ACOMPANHAMENTO_OPEN_BROWSER=0
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=acompanhamento_produtos
PGUSER=postgres
PGPASSWORD=ALTERAR_LOCALMENTE
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=5
# Gere valores aleatórios próprios antes de usar login JWT.
SESSION_SECRET_KEY=
SECRET_KEY=
JWT_ALGORITHM=HS256
